{
  "name": "ai-call-stack-claude",
  "displayName": "AI Call Stack for Claude Code",
  "description": "A live pane showing what Claude Code is doing as a call tree: prompt, subagents, tool calls, with status, duration, tokens, models, approvals, errors and compactions.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiCallStackClaude",
          "title": "Claude Call Tree",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aiCallStackClaude": [
        {
          "type": "webview",
          "id": "aiCallStackClaude.view",
          "name": "Call Tree"
        }
      ]
    },
    "commands": [
      {
        "command": "aiCallStackClaude.open",
        "title": "Open Call Tree",
        "category": "Claude Call Tree"
      },
      {
        "command": "aiCallStackClaude.installHooks",
        "title": "Add Hooks to Claude Code Settings",
        "category": "Claude Call Tree",
        "icon": "$(plug)"
      },
      {
        "command": "aiCallStackClaude.uninstallHooks",
        "title": "Remove Hooks from Claude Code Settings",
        "category": "Claude Call Tree"
      },
      {
        "command": "aiCallStackClaude.clear",
        "title": "Clear Recorded Calls",
        "category": "Claude Call Tree",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "AI Call Stack for Claude Code",
      "properties": {
        "aiCallStackClaude.defaultView": {
          "type": "string",
          "enum": [
            "tree",
            "waterfall"
          ],
          "default": "waterfall",
          "description": "How the rows draw at first: a tree of duration bars, or a waterfall on a time axis."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "aiCallStackClaude.clear",
          "when": "view == aiCallStackClaude.view",
          "group": "navigation@1"
        },
        {
          "command": "aiCallStackClaude.installHooks",
          "when": "view == aiCallStackClaude.view",
          "group": "9_hooks@1"
        },
        {
          "command": "aiCallStackClaude.uninstallHooks",
          "when": "view == aiCallStackClaude.view",
          "group": "9_hooks@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "tsc -p . && node --test out/test/",
    "package": "npm run build && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "typescript": "^5.6.0"
  }
}
