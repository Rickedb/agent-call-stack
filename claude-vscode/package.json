{
  "name": "agent-call-stack-claude",
  "displayName": "Agent Call Stack for Claude",
  "description": "See what Claude Code is doing as a live call stack: prompts, the model's thinking and replies, subagents and tool calls, as a tree or a waterfall with status, duration, models, tokens, approvals, errors and compactions.",
  "version": "0.1.1",
  "publisher": "rickedb",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rickedb/agent-call-stack.git",
    "directory": "claude-vscode"
  },
  "bugs": {
    "url": "https://github.com/Rickedb/agent-call-stack/issues"
  },
  "homepage": "https://github.com/Rickedb/agent-call-stack#readme",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Visualization"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentCallStackClaude",
          "title": "Agent Call Stack for Claude",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentCallStackClaude": [
        {
          "type": "webview",
          "id": "agentCallStackClaude.view",
          "name": "Call Stack"
        }
      ]
    },
    "commands": [
      {
        "command": "agentCallStackClaude.open",
        "title": "Open Call Stack",
        "category": "Agent Call Stack for Claude"
      },
      {
        "command": "agentCallStackClaude.installHooks",
        "title": "Add Hooks to Claude Code Settings",
        "category": "Agent Call Stack for Claude",
        "icon": "$(plug)"
      },
      {
        "command": "agentCallStackClaude.uninstallHooks",
        "title": "Remove Hooks from Claude Code Settings",
        "category": "Agent Call Stack for Claude"
      },
      {
        "command": "agentCallStackClaude.clear",
        "title": "Clear Recorded Calls",
        "category": "Agent Call Stack for Claude",
        "icon": "$(clear-all)"
      }
    ],
    "configuration": {
      "title": "Agent Call Stack for Claude",
      "properties": {
        "agentCallStackClaude.defaultView": {
          "type": "string",
          "enum": [
            "tree",
            "waterfall"
          ],
          "default": "waterfall",
          "description": "How the rows draw at first: a tree of duration bars, or a waterfall on a time axis."
        },
        "agentCallStackClaude.useElectronAsNode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run the hooks with VS Code's own executable as node (`ELECTRON_RUN_AS_NODE=1`) instead of a `node` found on this machine. Off by default: `node` is used directly, with its full path, and VS Code is the fallback when no `node` is found. On Windows it goes through a small `record.cmd` launcher. Reload the window after changing it."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "agentCallStackClaude.clear",
          "when": "view == agentCallStackClaude.view",
          "group": "navigation@1"
        },
        {
          "command": "agentCallStackClaude.installHooks",
          "when": "view == agentCallStackClaude.view",
          "group": "9_hooks@1"
        },
        {
          "command": "agentCallStackClaude.uninstallHooks",
          "when": "view == agentCallStackClaude.view",
          "group": "9_hooks@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "npm run build && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.95.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "agent",
    "call stack",
    "trace",
    "hooks",
    "subagents",
    "tool calls",
    "tokens",
    "observability"
  ],
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/rickedb"
  }
}
